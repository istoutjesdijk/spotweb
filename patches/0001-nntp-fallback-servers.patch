diff --git a/tests/Support/NntpFailoverFixtureServer.php b/tests/Support/NntpFailoverFixtureServer.php
new file mode 100644
index 0000000..1779395
--- /dev/null
+++ b/tests/Support/NntpFailoverFixtureServer.php
@@ -0,0 +1,145 @@
+<?php
+
+/*
+ * Small NNTP server for the fallback tests. Unlike NntpFixtureServer it serves
+ * several connections at once, because the failover transport keeps
+ * connections to more than one server open.
+ *
+ * Every message-id in $messageIds is an article in group "free.pt"; anything
+ * else gets 430. AUTHINFO USER "wrong" is refused with 481 and POST with 440.
+ * Every command is appended to $commandLog. The server exits after a few
+ * seconds without activity.
+ */
+class NntpFailoverFixtureServer
+{
+    public static function start(array $messageIds, $commandLog)
+    {
+        $server = stream_socket_server('tcp://127.0.0.1:0', $errno, $errstr);
+        if (!is_resource($server)) {
+            throw new RuntimeException($errstr);
+        }
+
+        $name = stream_socket_get_name($server, false);
+        list($host, $port) = explode(':', $name);
+
+        $pid = pcntl_fork();
+        if ($pid === 0) {
+            self::serve($server, $messageIds, $commandLog, (int) $port);
+            exit(0);
+        }
+
+        fclose($server);
+
+        return ['host' => $host, 'port' => (int) $port, 'pid' => $pid];
+    }
+
+    public static function stop(array $fixture)
+    {
+        if (function_exists('posix_kill')) {
+            posix_kill($fixture['pid'], defined('SIGTERM') ? SIGTERM : 15);
+        }
+        pcntl_waitpid($fixture['pid'], $status);
+    }
+
+    private static function serve($server, array $messageIds, $commandLog, $port)
+    {
+        $clients = [];
+        $buffers = [];
+
+        while (true) {
+            $read = array_merge([$server], array_values($clients));
+            $write = null;
+            $except = null;
+            if (!@stream_select($read, $write, $except, 5)) {
+                exit(0);
+            }
+
+            foreach ($read as $sock) {
+                if ($sock === $server) {
+                    $conn = @stream_socket_accept($server, 1);
+                    if ($conn) {
+                        $clients[(int) $conn] = $conn;
+                        $buffers[(int) $conn] = '';
+                        fwrite($conn, "200 fixture $port ready\r\n");
+                    }
+                    continue;
+                }
+
+                $chunk = @fread($sock, 8192);
+                if ($chunk === '' || $chunk === false) {
+                    unset($clients[(int) $sock], $buffers[(int) $sock]);
+                    fclose($sock);
+                    continue;
+                }
+                $buffers[(int) $sock] .= $chunk;
+
+                while (($pos = strpos($buffers[(int) $sock], "\n")) !== false) {
+                    $line = rtrim(substr($buffers[(int) $sock], 0, $pos), "\r\n");
+                    $buffers[(int) $sock] = substr($buffers[(int) $sock], $pos + 1);
+                    file_put_contents($commandLog, $line."\n", FILE_APPEND);
+
+                    if (!self::answer($sock, $line, $messageIds, $port)) {
+                        unset($clients[(int) $sock], $buffers[(int) $sock]);
+                        fclose($sock);
+                        continue 2;
+                    }
+                }
+            }
+        }
+    }
+
+    private static function answer($sock, $line, array $messageIds, $port)
+    {
+        $parts = preg_split('/\s+/', $line, 3);
+        $command = strtoupper($parts[0]);
+        $argument = isset($parts[1]) ? $parts[1] : '';
+
+        switch ($command) {
+            case 'AUTHINFO':
+                if (strtoupper($argument) === 'USER') {
+                    fwrite($sock, (isset($parts[2]) && $parts[2] === 'wrong') ? "481 authentication rejected\r\n" : "381 password required\r\n");
+                } else {
+                    fwrite($sock, "281 authentication accepted\r\n");
+                }
+                break;
+            case 'GROUP':
+                fwrite($sock, '211 '.count($messageIds).' 1 '.count($messageIds).' '.$argument."\r\n");
+                break;
+            case 'XHDR':
+                list($first, $last) = array_map('intval', explode('-', isset($parts[2]) ? $parts[2] : '0-0'));
+                $out = "221 Message-ID follows\r\n";
+                foreach (array_values($messageIds) as $index => $messageId) {
+                    if ($index + 1 >= $first && $index + 1 <= $last) {
+                        $out .= ($index + 1).' <'.$messageId.">\r\n";
+                    }
+                }
+                fwrite($sock, $out.".\r\n");
+                break;
+            case 'ARTICLE':
+            case 'HEAD':
+            case 'BODY':
+                $messageId = trim($argument, '<>');
+                if (!in_array($messageId, $messageIds, true)) {
+                    fwrite($sock, "430 no such article\r\n");
+                    break;
+                }
+                $header = "Message-ID: <$messageId>\r\nSubject: $messageId\r\nX-Served-By: $port\r\n";
+                $body = "body of $messageId from $port\r\n";
+                $codes = ['ARTICLE' => 220, 'HEAD' => 221, 'BODY' => 222];
+                $texts = ['ARTICLE' => $header."\r\n".$body, 'HEAD' => $header, 'BODY' => $body];
