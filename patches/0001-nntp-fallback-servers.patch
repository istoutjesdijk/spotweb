diff --git a/lib/services/Nntp/Services_Nntp_FailoverTransport.php b/lib/services/Nntp/Services_Nntp_FailoverTransport.php
new file mode 100644
index 0000000..f4a6c95
--- /dev/null
+++ b/lib/services/Nntp/Services_Nntp_FailoverTransport.php
@@ -0,0 +1,514 @@
+<?php
+
+require_once __DIR__.'/Services_Nntp_PipelinedTransport.php';
+require_once __DIR__.'/Services_Nntp_PipelinedFetchException.php';
+require_once __DIR__.'/Services_Nntp_FallbackServers.php';
+require_once __DIR__.'/Services_Nntp_ServerPenaltyBox.php';
+
+/*
+ * A transport over the newsserver for a role plus its fallback servers
+ * (setting 'nntp_fallback'), tried in priority order where 0 is the highest:
+ *
+ * - Reads by message-id (HEAD, BODY, ARTICLE and the pipelined fetch) use a
+ *   try-list per article. When a server answers 430 or fails, the next server
+ *   is asked for the articles that are still missing.
+ * - Reads by article number (GROUP, XOVER, XHDR) depend on per-server
+ *   numbering, so they stick to the first server that accepts the GROUP and
+ *   never switch halfway through a session.
+ * - Posting only moves on when connecting or logging in fails, so an article
+ *   is never posted twice.
+ *
+ * A server that cannot be connected to is skipped for a few minutes, see
+ * Services_Nntp_ServerPenaltyBox.
+ */
+class Services_Nntp_FailoverTransport extends Services_Nntp_PipelinedTransport
+{
+    /* @var Services_Nntp_PipelinedTransport[] in priority order */
+    private $_children = [];
+    /* @var array[] server descriptions, same keys as $_children */
+    private $_servers = [];
+    private $_used = [];
+    /* Index of the server that serves article-number commands, or null. */
+    private $_active = null;
+    private $_role;
+    private $_penalties;
+    private $_reporter;
+
+    /*
+     * Returns $primary unchanged when no fallback server serves $role, so an
+     * installation without fallback servers behaves exactly as before.
+     *
+     * $fallbackSetting is the 'nntp_fallback' setting.
+     */
+    public static function wrap(Services_Nntp_PipelinedTransport $primary, array $primaryServer, $role, $fallbackSetting, ?Services_Nntp_ServerPenaltyBox $penalties = null)
+    {
+        if ($primary instanceof self) {
+            return $primary;
+        }
+
+        $fallbacks = Services_Nntp_FallbackServers::forRole($fallbackSetting, $role);
+        if (empty($fallbacks)) {
+            return $primary;
+        }
+
+        $primaryServer['priority'] = Services_Nntp_FallbackServers::MinPriority;
+
+        $entries = [['server' => $primaryServer, 'transport' => $primary, 'order' => 0]];
+        foreach ($fallbacks as $i => $server) {
+            $entries[] = [
+                'server'    => $server,
+                'transport' => new Services_Nntp_PipelinedTransport($server, self::DEFAULT_TIMEOUT, $role),
+                'order'     => $i + 1,
+            ];
+        }
+
+        /* Priority first, then the configured order; the regular newsserver wins a tie. */
+        usort($entries, function ($a, $b) {
+            if ($a['server']['priority'] !== $b['server']['priority']) {
+                return $a['server']['priority'] < $b['server']['priority'] ? -1 : 1;
+            }
+
+            return $a['order'] - $b['order'];
+        });
+
+        return new self($entries, $role, $penalties);
+    }
+
+    public function __construct(array $entries, $role = 'direct', ?Services_Nntp_ServerPenaltyBox $penalties = null)
+    {
+        parent::__construct($entries[0]['server'], self::DEFAULT_TIMEOUT, $role);
+        foreach ($entries as $entry) {
+            $this->_children[] = $entry['transport'];
+            $this->_servers[] = $entry['server'];
+        }
+        $this->_role = $role;
+        $this->_penalties = $penalties ?: new Services_Nntp_ServerPenaltyBox();
+        $this->_reporter = function ($message) use ($role) {
+            if (PHP_SAPI === 'cli') {
+                fwrite(STDERR, 'NNTP fallback ('.$role.'): '.$message.PHP_EOL);
+            }
+        };
+    }
+
+    /*
+     * Receives a line for every failover, for example to show it in the
+     * output of retrieve.php. By default it goes to STDERR on the command line.
+     */
+    public function setReporter(callable $reporter)
+    {
+        $this->_reporter = $reporter;
+    }
+
+    /* Server list in priority order, without credentials. For logging and tests. */
+    public function describeServers()
+    {
+        $list = [];
+        foreach ($this->_servers as $server) {
+            $list[] = $this->label($server).' (priority '.$server['priority'].')';
+        }
+
+        return $list;
+    }
+
+    public function getActiveServer()
+    {
+        return ($this->_active === null) ? null : $this->label($this->_servers[$this->_active]);
+    }
+
+    public function getOpenedConnectionCount()
+    {
+        $count = 0;
+        foreach ($this->_children as $child) {
+            $count += $child->getOpenedConnectionCount();
+        }
+
+        return $count;
+    }
+
+    /* ---- connection management -------------------------------------- */
+
+    public function connect()
+    {
+        if ($this->_active !== null) {
+            $this->_children[$this->_active]->connect();
+
+            return;
+        }
+
+        $this->firstConnected();
+    }
+
+    public function disconnect()
+    {
+        foreach ($this->_children as $child) {
+            $child->disconnect();
+        }
+        $this->_active = null;
+        $this->_used = [];
+    }
+
+    public function quit()
+    {
+        foreach (array_keys($this->_used) as $i) {
+            $this->_children[$i]->quit();
+        }
+        $this->_active = null;
+        $this->_used = [];
+    }
+
+    public function withFreshConnection()
+    {
+        foreach (array_keys($this->_used) as $i) {
+            if ($i === $this->_active) {
+                $this->_children[$i]->withFreshConnection();
+            } else {
+                $this->_children[$i]->disconnect();
+                unset($this->_used[$i]);
+            }
+        }
+    }
+
+    public function resetErrorCount()
+    {
+    }
+
+    public function validateServer($group = 'free.pt')
+    {
+        $this->selectGroup($group);
+        $this->quit();
+    }
+
+    /* ---- article-number commands: sticky per session ---------------- */
+
+    public function selectGroup($group)
+    {
+        if ($this->_active !== null) {
+            return $this->_children[$this->_active]->selectGroup($group);
+        }
+
+        $last = null;
+        foreach ($this->candidates() as $i) {
+            if (!$this->ensureConnected($i, $last)) {
+                continue;
+            }
+
+            try {
+                $result = $this->_children[$i]->selectGroup($group);
+                $this->_active = $i;
+                if ($i !== 0) {
+                    $this->notice('nntp.failover.group', 'Using '.$this->label($this->_servers[$i]).' for '.$group);
+                }
+
+                return $result;
+            } catch (Exception $x) {
+                $last = $x;
+                $this->notice('nntp.failover.group_failed', $this->label($this->_servers[$i]).' refused GROUP '.$group.': '.$x->getMessage());
+            }
+        }
+
+        throw $this->exhausted($last);
+    }
+
+    public function getOverview($first, $last)
+    {
+        return $this->activeChild()->getOverview($first, $last);
+    }
+
+    public function getMessageIdByArticleNumber($articleNumber)
+    {
+        return $this->activeChild()->getMessageIdByArticleNumber($articleNumber);
+    }
+
+    public function getMessageIdList($first, $last)
+    {
+        return $this->activeChild()->getMessageIdList($first, $last);
+    }
+
+    public function sendNoop()
+    {
+        $this->activeChild()->sendNoop();
+    }
+
+    /* ---- message-id reads: per-article try-list --------------------- */
+
+    public function getHeader($messageId)
+    {
+        return $this->tryEach('head', $messageId, function ($child) use ($messageId) {
+            return $child->getHeader($messageId);
+        });
+    }
+
+    public function getBody($messageId)
+    {
+        return $this->tryEach('body', $messageId, function ($child) use ($messageId) {
+            return $child->getBody($messageId);
+        });
+    }
+
+    public function getArticle($messageId)
+    {
+        return $this->tryEach('article', $messageId, function ($child) use ($messageId) {
+            return $child->getArticle($messageId);
+        });
+    }
+
+    public function fetchArticlesPipelined(array $messageIds, $window = self::DEFAULT_PIPELINE_WINDOW)
+    {
+        $order = [];
+        foreach ($messageIds as $messageId) {
+            $order[] = self::strip($messageId);
+        }
+
+        $found = [];       // id => result (220)
+        $missing = [];     // id => last 430 result
+        $remaining = $order;
+        $lastError = null;
+
+        foreach ($this->candidates() as $i) {
+            if (empty($remaining)) {
+                break;
+            }
+            if (!$this->ensureConnected($i, $lastError)) {
+                continue;
+            }
+
+            $results = [];
+            $unresolved = [];
+            try {
+                $results = $this->_children[$i]->fetchArticlesPipelined($remaining, $window);
+            } catch (Services_Nntp_PipelinedFetchException $x) {
+                $results = $x->terminalResults();
+                $unresolved = $x->unresolvedMessageIds();
+                $lastError = $x;
+                $this->notice('nntp.failover.pipeline_failed', $this->label($this->_servers[$i]).': '.$x->getMessage().', '.count($unresolved).' unresolved');
+                $this->recover($i);
+            } catch (Exception $x) {
+                $unresolved = $remaining;
+                $lastError = $x;
+                $this->notice('nntp.failover.pipeline_failed', $this->label($this->_servers[$i]).': '.$x->getMessage());
+                $this->recover($i);
+            }
+
+            $next = [];
+            foreach ($results as $result) {
+                $id = self::strip($result->messageId);
+                if ($result->found()) {
+                    $found[$id] = $result;
+                    unset($missing[$id]);
+                } else {
+                    $missing[$id] = $result;
+                    $next[] = $id;
+                }
+            }
+            foreach ($unresolved as $id) {
+                $next[] = self::strip($id);
+            }
+
+            if (!empty($found) && $i !== 0 && count($next) < count($remaining)) {
+                SpotDebug::msg(SpotDebug::DEBUG, 'nntp.failover.pipeline_filled', [
+                    'role'   => $this->_role,
+                    'server' => $this->label($this->_servers[$i]),
+                    'filled' => count($remaining) - count($next),
+                ]);
+            }
+
+            $remaining = array_values(array_unique($next));
+        }
+
+        /* Original order. An id that one server reported as 430 and no server delivered counts as
+         * missing; an id no server answered for at all stays unresolved. */
+        $results = [];
+        $unresolvedIds = [];
+        foreach ($order as $id) {
+            if (isset($found[$id])) {
+                $results[] = $found[$id];
+            } elseif (isset($missing[$id])) {
+                $results[] = $missing[$id];
+            } else {
+                $unresolvedIds[] = $id;
+            }
+        }
+
+        if (!empty($unresolvedIds)) {
+            $x = $lastError ?: new NntpException('No usable newsserver for role '.$this->_role, -1);
+
+            throw new Services_Nntp_PipelinedFetchException(
+                $x->getMessage(),
+                $x->getCode(),
+                $results,
+                $unresolvedIds,
+                Services_Nntp_PipelinedFetchException::classify($x, 'transport')
+            );
+        }
+
+        return $results;
+    }
+
+    /* ---- posting: fail over only before anything was sent ----------- */
+
+    public function post(array $article)
+    {
+        $last = null;
+        foreach ($this->candidates() as $i) {
+            if (!$this->ensureConnected($i, $last)) {
+                continue;
+            }
+
+            /* Connected and logged in: whatever happens now is final. */
+            return $this->_children[$i]->post($article);
+        }
+
+        throw $this->exhausted($last);
+    }
+
+    /* ---- helpers ----------------------------------------------------- */
+
+    /*
+     * Server indexes in priority order, skipping servers in the penalty box.
+     * When every server is penalised, all of them are returned: trying is
+     * better than failing without a single attempt.
+     */
+    private function candidates()
+    {
+        $list = [];
+        foreach (array_keys($this->_children) as $i) {
+            if (isset($this->_used[$i]) || !$this->_penalties->isPenalized($this->key($i))) {
+                $list[] = $i;
+            }
+        }
+
+        return empty($list) ? array_keys($this->_children) : $list;
+    }
+
+    private function ensureConnected($i, &$lastError)
+    {
+        try {
+            $this->_children[$i]->connect();
+            if (!isset($this->_used[$i])) {
+                $this->_used[$i] = true;
+                $this->_penalties->clear($this->key($i));
+            }
+
+            return true;
+        } catch (Exception $x) {
+            $lastError = $x;
+            $minutes = Services_Nntp_ServerPenaltyBox::minutesFor($x);
+            $this->_penalties->penalize($this->key($i), $minutes);
+            unset($this->_used[$i]);
+            $this->notice('nntp.failover.connect_failed', $this->label($this->_servers[$i]).' unavailable ('.$x->getMessage().'), skipped for '.$minutes.' min');
+
+            return false;
+        }
+    }
+
+    /* A pipeline that broke off leaves unread responses on the socket; start that server afresh. */
+    private function recover($i)
+    {
+        try {
+            $this->_children[$i]->withFreshConnection();
+        } catch (Exception $x) {
+            $this->_children[$i]->disconnect();
+            unset($this->_used[$i]);
+            if ($this->_active === $i) {
+                $this->_active = null;
+            }
+        }
+    }
+
+    private function firstConnected()
+    {
+        $last = null;
+        foreach ($this->candidates() as $i) {
+            if ($this->ensureConnected($i, $last)) {
+                return $i;
+            }
+        }
+
+        throw $this->exhausted($last);
+    }
+
+    private function activeChild()
+    {
+        if ($this->_active === null) {
+            /* No GROUP yet: article numbers are meaningless, but keep upstream's behaviour of
+             * letting the server answer. Pin the first server that connects. */
+            $this->_active = $this->firstConnected();
+        }
+
+        return $this->_children[$this->_active];
+    }
+
+    private function tryEach($operation, $messageId, $callback)
+    {
+        $last = null;
+        $missing = null;
+        foreach ($this->candidates() as $i) {
+            if (!$this->ensureConnected($i, $last)) {
+                continue;
+            }
+
+            try {
+                $result = $callback($this->_children[$i]);
+                if ($i !== 0) {
+                    SpotDebug::msg(SpotDebug::DEBUG, 'nntp.failover.read', [
+                        'role'      => $this->_role,
+                        'operation' => $operation,
+                        'server'    => $this->label($this->_servers[$i]),
+                    ]);
+                }
+
+                return $result;
+            } catch (Exception $x) {
+                if ((int) $x->getCode() === 430) {
+                    $missing = $x;
+                } else {
+                    $last = $x;
+                    $this->notice('nntp.failover.read_failed', $this->label($this->_servers[$i]).' '.$operation.' failed: '.$x->getMessage());
+                }
+            }
+        }
+
+        /* Prefer "article missing" over a transport error: that is what the caller handles. */
+        throw $missing ?: $this->exhausted($last);
+    }
+
+    private function exhausted($last)
+    {
+        if ($last instanceof Exception) {
+            return $last;
+        }
+
+        return new NntpException('No usable newsserver for role '.$this->_role, -1);
+    }
+
+    private function key($i)
+    {
+        $s = $this->_servers[$i];
+
+        return strtolower($s['host']).':'.(int) $s['port'].':'.(isset($s['user']) ? $s['user'] : '');
+    }
+
+    private function label(array $server)
+    {
+        $name = isset($server['name']) ? $server['name'] : '';
+        $host = $server['host'].':'.(int) $server['port'];
+
+        return ($name !== '' && $name !== $server['host']) ? $name.' ('.$host.')' : $host;
+    }
+
+    private function notice($event, $message)
+    {
+        SpotDebug::msg(SpotDebug::WARN, $event, ['role' => $this->_role, 'message' => $message]);
+        call_user_func($this->_reporter, $message);
+    }
+
+    private static function strip($messageId)
+    {
+        $messageId = trim((string) $messageId);
+        if ((strlen($messageId) >= 2) && ($messageId[0] === '<') && (substr($messageId, -1) === '>')) {
+            return substr($messageId, 1, -1);
+        }
+
+        return $messageId;
+    }
+}
diff --git a/lib/services/Nntp/Services_Nntp_FallbackServers.php b/lib/services/Nntp/Services_Nntp_FallbackServers.php
new file mode 100644
index 0000000..8de7673
--- /dev/null
+++ b/lib/services/Nntp/Services_Nntp_FallbackServers.php
@@ -0,0 +1,179 @@
+<?php
+
+require_once __DIR__.'/Services_Nntp_Encryption.php';
+require_once __DIR__.'/Services_Nntp_PipelineDepth.php';
+
+/*
+ * Settings semantics for fallback newsservers (setting 'nntp_fallback').
+ *
+ * A fallback server is asked when the newsserver for a role fails or does not
+ * have an article. Servers are tried in priority order, 0 being the highest;
+ * the newsserver from the regular settings has priority 0 and goes first on a
+ * tie. Each fallback serves a selection of roles: 'hdr' (retrieving spots and
+ * comments), 'bin' (NZB files and images) and 'post'.
+ */
+class Services_Nntp_FallbackServers
+{
+    const SettingName = 'nntp_fallback';
+    const MaxServers = 3;
+    const MinPriority = 0;
+    const MaxPriority = 99;
+    const DefaultPriority = 1;
+
+    public static function roles()
+    {
+        return ['hdr', 'bin', 'post'];
+    }
+
+    public static function defaultRoles()
+    {
+        return ['hdr', 'bin'];
+    }
+
+    public static function emptyServer()
+    {
+        return [
+            'use'                                     => false,
+            'host'                                    => '',
+            'user'                                    => '',
+            'pass'                                    => '',
+            'enc'                                     => Services_Nntp_Encryption::ImplicitTls,
+            'port'                                    => 563,
+            'verifyname'                              => true,
+            'priority'                                => self::DefaultPriority,
+            'roles'                                   => self::defaultRoles(),
+            Services_Nntp_PipelineDepth::SettingName  => Services_Nntp_PipelineDepth::DefaultDepth,
+        ];
+    }
+
+    /*
+     * Always MaxServers entries, for the settings form.
+     */
+    public static function slots($configured)
+    {
+        $slots = [];
+        $configured = is_array($configured) ? array_values($configured) : [];
+        for ($i = 0; $i < self::MaxServers; $i++) {
+            $server = (isset($configured[$i]) && is_array($configured[$i])) ? $configured[$i] : [];
+            $slots[] = array_merge(self::emptyServer(), $server);
+        }
+
+        return $slots;
+    }
+
+    /*
+     * Validates the fallback part of the settings form. Returns the servers to
+     * store and a list of error messages. Servers that are switched off keep
+     * their values, so they can be switched on again later.
+     */
+    public static function validate($input)
+    {
+        $servers = [];
+        $errors = [];
+        $input = is_array($input) ? array_values($input) : [];
+
+        for ($i = 0; $i < min(count($input), self::MaxServers); $i++) {
+            $form = is_array($input[$i]) ? $input[$i] : [];
+            $label = sprintf(_('Fallback newsserver %d'), $i + 1);
+
+            $server = self::emptyServer();
+            $server['use'] = isset($form['use']);
+            $server['host'] = isset($form['host']) ? trim($form['host']) : '';
+            $server['user'] = isset($form['user']) ? trim($form['user']) : '';
+            $server['pass'] = isset($form['pass']) ? (string) $form['pass'] : '';
+            $server['verifyname'] = isset($form['verifyname']['switch']);
+
+            $enc = (isset($form['enc']['switch']) && isset($form['enc']['select'])) ? $form['enc']['select'] : false;
+            $server['enc'] = Services_Nntp_Encryption::normalize($enc);
+
+            $server['roles'] = [];
+            foreach (self::roles() as $role) {
+                if (isset($form['roles'][$role])) {
+                    $server['roles'][] = $role;
+                }
+            }
+
+            $port = isset($form['port']) ? trim($form['port']) : '';
+            $priority = isset($form['priority']) ? trim($form['priority']) : '';
+
+            if (!$server['use'] && $server['host'] === '') {
+                continue;
+            }
+
+            if ($server['use']) {
+                if ($server['host'] === '') {
+                    $errors[] = $label.': '._('hostname cannot be empty');
+                }
+                if ($server['enc'] === null) {
+                    $errors[] = $label.': '._('Invalid encryption setting');
+                }
+                if (!self::isIntegerBetween($port, 1, 65535)) {
+                    $errors[] = $label.': '._('port must be an integer between 1 and 65535');
+                }
+                if (!self::isIntegerBetween($priority, self::MinPriority, self::MaxPriority)) {
+                    $errors[] = $label.': '._('priority must be an integer between 0 and 99');
+                }
+                if (empty($server['roles'])) {
+                    $errors[] = $label.': '._('select at least one task');
+                }
+            }
+
+            if ($server['enc'] === null) {
+                $server['enc'] = false;
+            }
+            $server['port'] = self::isIntegerBetween($port, 1, 65535) ? (int) $port : ($server['enc'] === Services_Nntp_Encryption::ImplicitTls ? 563 : 119);
+            $server['priority'] = self::isIntegerBetween($priority, self::MinPriority, self::MaxPriority) ? (int) $priority : self::DefaultPriority;
+
+            $servers[] = $server;
+        }
+
+        return ['servers' => $servers, 'errors' => $errors];
+    }
+
+    /*
+     * The switched-on fallback servers for $role, in the order they were
+     * configured. The transport sorts them by priority.
+     */
+    public static function forRole($configured, $role)
+    {
+        $result = [];
+        if (!is_array($configured)) {
+            return $result;
+        }
+
+        foreach ($configured as $server) {
+            if (!is_array($server) || empty($server['use']) || empty($server['host'])) {
+                continue;
+            }
+            if (!isset($server['roles']) || !is_array($server['roles']) || !in_array($role, $server['roles'], true)) {
+                continue;
+            }
+            $enc = Services_Nntp_Encryption::normalize(isset($server['enc']) ? $server['enc'] : false);
+            if ($enc === null) {
+                continue;
+            }
+
+            $server = array_merge(self::emptyServer(), $server);
+            $server['enc'] = $enc;
+            $server['port'] = (int) $server['port'];
+            $server['priority'] = (int) $server['priority'];
+            $server['buggy'] = false;
+            $result[] = Services_Nntp_PipelineDepth::normalizeServer($server);
+        }
+
+        return $result;
+    }
+
+    private static function isIntegerBetween($value, $min, $max)
+    {
+        if (!is_string($value) && !is_int($value)) {
+            return false;
+        }
+        $value = (string) $value;
+        if (!preg_match('/^\d+$/', $value)) {
+            return false;
+        }
+
+        return ((int) $value >= $min) && ((int) $value <= $max);
+    }
+}
diff --git a/lib/services/Nntp/Services_Nntp_ServerPenaltyBox.php b/lib/services/Nntp/Services_Nntp_ServerPenaltyBox.php
new file mode 100644
index 0000000..4b08f5e
--- /dev/null
+++ b/lib/services/Nntp/Services_Nntp_ServerPenaltyBox.php
@@ -0,0 +1,107 @@
+<?php
+
+/*
+ * Remembers newsservers that recently failed, so they are skipped for a few
+ * minutes instead of being retried on every request. Every web request and
+ * every retrieve run is a separate PHP process, so the state lives in a small
+ * JSON file guarded by flock(). Keys are host:port:user, never passwords.
+ */
+class Services_Nntp_ServerPenaltyBox
+{
+    /* Minutes, as in SABnzbd's downloader. */
+    const PENALTY_PERM = 10;
+    const PENALTY_TIMEOUT = 10;
+    const PENALTY_UNKNOWN = 3;
+
+    private $_file;
+
+    public function __construct($file = null)
+    {
+        if (empty($file)) {
+            $file = rtrim(sys_get_temp_dir(), '/').'/spotweb-nntp-penalty.json';
+        }
+        $this->_file = $file;
+    }
+
+    public static function minutesFor(Exception $x)
+    {
+        $code = (int) $x->getCode();
+        if (in_array($code, [481, 482, 502], true)) {
+            return self::PENALTY_PERM;
+        }
+        if (stripos($x->getMessage(), 'timed out') !== false) {
+            return self::PENALTY_TIMEOUT;
+        }
+
+        return self::PENALTY_UNKNOWN;
+    }
+
+    public function isPenalized($key)
+    {
+        $state = $this->read();
+
+        return isset($state[$key]) && ($state[$key] > time());
+    }
+
+    public function penalize($key, $minutes)
+    {
+        $this->update(function (array $state) use ($key, $minutes) {
+            $state[$key] = time() + (int) round($minutes * 60);
+
+            return $state;
+        });
+    }
+
+    public function clear($key)
+    {
+        if (!$this->isPenalized($key)) {
+            return;
+        }
+        $this->update(function (array $state) use ($key) {
+            unset($state[$key]);
+
+            return $state;
+        });
+    }
+
+    private function read()
+    {
+        $raw = @file_get_contents($this->_file);
+        if ($raw === false || $raw === '') {
+            return [];
+        }
+        $state = json_decode($raw, true);
+
+        return is_array($state) ? $state : [];
+    }
+
+    private function update($mutator)
+    {
+        $fh = @fopen($this->_file, 'c+');
+        if ($fh === false) {
+            return;
+        }
+
+        try {
+            if (!flock($fh, LOCK_EX)) {
+                return;
+            }
+            $raw = stream_get_contents($fh);
+            $state = json_decode((string) $raw, true);
+            if (!is_array($state)) {
+                $state = [];
+            }
+            $now = time();
+            $state = array_filter($mutator($state), function ($until) use ($now) {
+                return $until > $now;
+            });
+            ftruncate($fh, 0);
+            rewind($fh);
+            fwrite($fh, json_encode($state));
+            fflush($fh);
+            flock($fh, LOCK_UN);
+        } finally {
+            fclose($fh);
+        }
+    }
+}
