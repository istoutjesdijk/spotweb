diff --git a/tests/Services/Nntp/ServicesNntpFailoverTransportTest.php b/tests/Services/Nntp/ServicesNntpFailoverTransportTest.php
new file mode 100644
index 0000000..72ed7d2
--- /dev/null
+++ b/tests/Services/Nntp/ServicesNntpFailoverTransportTest.php
@@ -0,0 +1,303 @@
+<?php
+
+use PHPUnit\Framework\TestCase;
+
+require_once __DIR__.'/../../../lib/services/Nntp/Services_Nntp_ClientPool.php';
+require_once __DIR__.'/../../Support/NntpFailoverFixtureServer.php';
+
+class NntpFailoverSettingsSource implements Services_Settings_IContainer
+{
+    private $_settings;
+
+    public function __construct(array $settings)
+    {
+        $this->_settings = $settings;
+    }
+
+    public function initialize(array $cfg)
+    {
+    }
+
+    public function getAllSettings()
+    {
+        return $this->_settings;
+    }
+
+    public function remove($name)
+    {
+        unset($this->_settings[$name]);
+    }
+
+    public function set($name, $value)
+    {
+        $this->_settings[$name] = $value;
+    }
+}
+
+class ServicesNntpFailoverTransportTest extends TestCase
+{
+    private $_fixtures = [];
+    private $_files = [];
+
+    protected function setUp(): void
+    {
+        if (!function_exists('pcntl_fork')) {
+            $this->markTestSkipped('The NNTP fixture servers require pcntl');
+        }
+        $this->resetStatic(Services_Nntp_ClientPool::class, ['_instances' => []]);
+        $this->resetStatic(Services_Settings_Container::class, ['_instance' => null, '_settings' => [], '_sources' => []]);
+    }
+
+    protected function tearDown(): void
+    {
+        foreach ($this->_fixtures as $fixture) {
+            NntpFailoverFixtureServer::stop($fixture);
+        }
+        foreach ($this->_files as $file) {
+            @unlink($file);
+        }
+        $this->resetStatic(Services_Nntp_ClientPool::class, ['_instances' => []]);
+        $this->resetStatic(Services_Settings_Container::class, ['_instance' => null, '_settings' => [], '_sources' => []]);
+    }
+
+    public function testMissingArticleIsFetchedFromTheFallback()
+    {
+        $primary = $this->fixture(['b']);
+        $fallback = $this->fixture(['a', 'b', 'c']);
+        $transport = $this->failover($primary, [$this->fallback($fallback)]);
+
+        $this->assertInstanceOf(Services_Nntp_FailoverTransport::class, $transport);
+        $this->assertSame($fallback['port'], $this->servedBy($transport->getBody('<a>')));
+        $this->assertSame($primary['port'], $this->servedBy($transport->getBody('b')));
+        $transport->quit();
+    }
+
+    public function testUnreachableServerIsSkippedAndPenalised()
+    {
+        $fallback = $this->fixture(['b']);
+        $closedPort = $this->closedPort();
+        $penalties = $this->penaltyBox();
+        $transport = $this->failover(['host' => '127.0.0.1', 'port' => $closedPort], [$this->fallback($fallback)], 'bin', $penalties);
+
+        $this->assertSame($fallback['port'], $this->servedBy($transport->getBody('b')));
+        $this->assertTrue($penalties->isPenalized('127.0.0.1:'.$closedPort.':'));
+        $transport->quit();
+    }
+
+    public function testPipelinedFetchFillsGapsAndKeepsOrder()
+    {
+        $primary = $this->fixture(['b']);
+        $fallback = $this->fixture(['a', 'b', 'c']);
+        $transport = $this->failover($primary, [$this->fallback($fallback)]);
+
+        $results = $transport->fetchArticlesPipelined(['<a>', '<b>', '<c>'], 4);
+
+        $this->assertSame(['a', 'b', 'c'], array_map(function ($result) {
+            return $result->messageId;
+        }, $results));
+        $this->assertSame([true, true, true], array_map(function ($result) {
+            return $result->found();
+        }, $results));
+        $this->assertSame([$fallback['port'], $primary['port'], $fallback['port']], array_map(function ($result) {
+            return $this->servedBy($result->header);
+        }, $results));
+        $transport->quit();
+    }
+
+    public function testArticleMissingEverywhereReportsNotFound()
+    {
+        $primary = $this->fixture(['b']);
+        $fallback = $this->fixture(['a']);
+        $transport = $this->failover($primary, [$this->fallback($fallback)]);
+
+        try {
+            $transport->getBody('<missing>');
+            $this->fail('An article that no server has must raise 430');
+        } catch (NntpException $exception) {
+            $this->assertSame(430, $exception->getCode());
+        }
+
+        $results = $transport->fetchArticlesPipelined(['missing', 'a'], 4);
+        $this->assertSame(430, $results[0]->code);
+        $this->assertTrue($results[1]->found());
+        $transport->quit();
+    }
+
+    public function testArticleNumberCommandsStickToOneServer()
+    {
+        $fallback = $this->fixture(['a', 'b']);
+        $transport = $this->failover(['host' => '127.0.0.1', 'port' => $this->closedPort()], [$this->fallback($fallback)], 'hdr');
+
+        $group = $transport->selectGroup('free.pt');
+
+        $this->assertSame('127.0.0.1:'.$fallback['port'], $transport->getActiveServer());
+        $this->assertSame('a', $transport->getMessageIdByArticleNumber($group['first']));
+        $transport->quit();
+    }
+
+    public function testPriorityDecidesTheOrderAndTheRegularServerWinsATie()
+    {
+        $primary = $this->fixture(['a']);
+        $low = $this->fixture(['a']);
+        $high = $this->fixture(['a']);
+        $transport = $this->failover($primary, [$this->fallback($low, ['priority' => 5]), $this->fallback($high, ['priority' => 0])]);
+
+        $this->assertSame([
+            '127.0.0.1:'.$primary['port'].' (priority 0)',
+            '127.0.0.1:'.$high['port'].' (priority 0)',
+            '127.0.0.1:'.$low['port'].' (priority 5)',
+        ], $transport->describeServers());
+        $this->assertSame($primary['port'], $this->servedBy($transport->getBody('a')));
+        $transport->quit();
+    }
+
+    public function testRejectedLoginMovesOnToTheNextServer()
+    {
+        $wrong = $this->fixture(['c']);
+        $good = $this->fixture(['c']);
+        $penalties = $this->penaltyBox();
+        $transport = $this->failover(
+            ['host' => '127.0.0.1', 'port' => $this->closedPort()],
+            [$this->fallback($wrong, ['priority' => 1, 'user' => 'wrong', 'pass' => 'x']), $this->fallback($good, ['priority' => 2])],
+            'bin',
+            $penalties
+        );
+
+        $this->assertSame($good['port'], $this->servedBy($transport->getBody('c')));
+        $this->assertTrue($penalties->isPenalized('127.0.0.1:'.$wrong['port'].':wrong'));
+        $transport->quit();
+    }
+
+    public function testWithoutFallbackServersTheTransportIsLeftAlone()
+    {
+        $plain = new Services_Nntp_PipelinedTransport(['host' => '127.0.0.1', 'port' => 119], 1, 'bin');
+        $server = ['host' => 'fallback.example.invalid', 'port' => 563];
+
+        $this->assertSame($plain, Services_Nntp_FailoverTransport::wrap($plain, [], 'bin', null));
+        $this->assertSame($plain, Services_Nntp_FailoverTransport::wrap($plain, [], 'bin', []));
+        $this->assertSame($plain, Services_Nntp_FailoverTransport::wrap($plain, [], 'bin', [$this->fallback($server, ['roles' => ['post']])]));
+        $this->assertSame($plain, Services_Nntp_FailoverTransport::wrap($plain, [], 'bin', [$this->fallback($server, ['use' => false])]));
+    }
+
+    public function testPostingIsNotRetriedOnAnotherServer()
+    {
+        $primary = $this->fixture([]);
+        $fallback = $this->fixture([]);
+        $transport = $this->failover($primary, [$this->fallback($fallback, ['roles' => ['post']])], 'post');
+
+        try {
+            $transport->post([['Subject: test'], ['body']]);
+            $this->fail('A refused post must be reported');
+        } catch (Exception $exception) {
+            $this->assertStringNotContainsString('POST', (string) @file_get_contents($fallback['log']));
+        }
+        $transport->quit();
+    }
+
+    public function testClientPoolCombinesTheRoleWithItsFallbackServers()
+    {
+        $primary = $this->fixture(['b']);
+        $fallback = $this->fixture(['a']);
+        $server = ['host' => $primary['host'], 'port' => $primary['port'], 'user' => '', 'pass' => '', 'enc' => false, 'verifyname' => false, 'buggy' => false];
+
+        $settings = new Services_Settings_Container();
+        $settings->addSource(new NntpFailoverSettingsSource([
+            'nntp_hdr'      => $server,
+            'nntp_nzb'      => $server,
+            'nntp_post'     => $server,
+            'nntp_fallback' => [$this->fallback($fallback, ['roles' => ['bin']])],
+        ]));
+
+        $bin = Services_Nntp_ClientPool::pool($settings, 'bin');
+        $hdr = Services_Nntp_ClientPool::pool($settings, 'hdr');
+
+        $this->assertInstanceOf(Services_Nntp_FailoverTransport::class, $bin);
+        $this->assertSame(Services_Nntp_PipelinedTransport::class, get_class($hdr));
+        $this->assertInstanceOf(Services_Nntp_SpotReader::class, new Services_Nntp_SpotReader($bin));
+        $bin->setReporter(function () {
+        });
+        $this->assertSame($fallback['port'], $this->servedBy($bin->getBody('a')));
+        $bin->quit();
+    }
+
+    private function failover(array $primary, array $fallbacks, $role = 'bin', $penalties = null)
+    {
+        $primary += ['user' => '', 'pass' => '', 'enc' => false, 'verifyname' => false];
+        unset($primary['pid'], $primary['log']);
+        $transport = Services_Nntp_FailoverTransport::wrap(
+            new Services_Nntp_PipelinedTransport($primary, 2, $role),
+            $primary,
+            $role,
+            $fallbacks,
+            $penalties ?: $this->penaltyBox()
+        );
+        $transport->setReporter(function () {
+        });
+
+        return $transport;
+    }
+
+    private function fallback(array $fixture, array $extra = [])
+    {
+        return $extra + [
+            'use'        => true,
+            'host'       => $fixture['host'],
+            'port'       => $fixture['port'],
+            'user'       => '',
+            'pass'       => '',
+            'enc'        => false,
+            'verifyname' => false,
+            'priority'   => 1,
+            'roles'      => ['hdr', 'bin', 'post'],
+        ];
+    }
+
+    private function fixture(array $messageIds)
+    {
+        $log = tempnam(sys_get_temp_dir(), 'spotweb-failover-log-');
+        $this->_files[] = $log;
+        $fixture = NntpFailoverFixtureServer::start($messageIds, $log);
+        $fixture['log'] = $log;
+        $this->_fixtures[] = $fixture;
+
+        return $fixture;
+    }
+
+    private function penaltyBox()
+    {
+        $file = tempnam(sys_get_temp_dir(), 'spotweb-penalty-');
+        $this->_files[] = $file;
+
+        return new Services_Nntp_ServerPenaltyBox($file);
+    }
+
+    private function closedPort()
+    {
+        $socket = stream_socket_server('tcp://127.0.0.1:0');
+        $name = stream_socket_get_name($socket, false);
+        fclose($socket);
+
+        return (int) substr($name, strrpos($name, ':') + 1);
+    }
+
+    private function servedBy(array $lines)
+    {
+        foreach ($lines as $line) {
+            if (preg_match('/^X-Served-By: (\d+)/', $line, $match) || preg_match('/ from (\d+)$/', $line, $match)) {
+                return (int) $match[1];
+            }
+        }
+
+        return null;
+    }
+
+    private function resetStatic($className, array $values)
+    {
+        $class = new ReflectionClass($className);
+        foreach ($values as $name => $value) {
+            $property = $class->getProperty($name);
+            $property->setAccessible(true);
+            $property->setValue(null, $value);
+        }
+    }
+}
